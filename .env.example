# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexus-pro?retryWrites=true&w=majority

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Client-side (prefixed with NEXT_PUBLIC_, injected at build time)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
SOCKET_PORT=